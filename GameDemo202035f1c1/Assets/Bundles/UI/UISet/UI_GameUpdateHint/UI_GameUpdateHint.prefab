  m_Text: "\u5F53\u524D\u6E38\u620F\u7248\u672C\u8FC7\u4F4E\uFF0C\u60A8\u9700\u8981\u4E0B\u8F7D\u65B0\u7248\u672C\u3002\n\u8BF7\u5230\u4EFB\u610F\u5B98\u65B9QQ\u7FA4\u91CC\u4E0B\u8F7D\u6700\u65B0\u7684\u5B89\u88C5\u5305\u8FDB\u884C\u8986\u76D6\u5B89\u88C5\uFF01\uFF08\u5982\u679C\u6CA1\u6709\u53EF\u4EE5\u52A0QQ\u7FA4\uFF1A:791452449\uFF09\n\u6216\u8005\u70B9\u51FB\u4E0B\u65B9\u94FE\u63A5\u4E0B\u8F7D\u5F53\u524D\u6E38\u620F\u6700\u65B0\u7248\u672C\u8986\u76D6\u5B89\u88C5"
