  - Term: WorldHint_4
    TermType: 0
    Description: 
    Languages:
    - "2. \u4F4E\u4E8E\u809D\u5E1D\u7B49\u7EA7\u7684\u73A9\u5BB6\u53EF\u4EE5\u4F7F\u7528\u7ECF\u9A8C\u6728\u6869\u83B7\u5F97\u591A\u500D\u7ECF\u9A8C\u3002\r"
