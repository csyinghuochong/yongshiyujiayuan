    - 
    - 
    Flags: 0000
  - Term: yindao_2
    TermType: 0
    Description: 
    Languages:
    - "\u6253\u5F00\u5C0F\u5730\u56FE,\u70B9\u51FB\u79FB\u52A8\n\u5FEB\u901F\u627E\u5230\u602A\u7269\u4F4D\u7F6E"
    - "\rOpen the game settings, save the data permanently to the server, open the
      small map, click move to find the monster location quickly"
